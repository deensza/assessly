# Copy this file to .env and fill in the values
# cp .env.example .env

# Flask
SECRET_KEY=change-me-to-a-random-secret
JWT_SECRET_KEY=change-me-to-another-random-secret

# PostgreSQL
POSTGRES_DB=assessly
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Database URL (used by Flask)
DATABASE_URL=postgresql://postgres:change-me-to-a-strong-password@db:5432/assessly

# Sandbox limits
SANDBOX_TIME_LIMIT=10
SANDBOX_MEMORY_LIMIT=256
SANDBOX_CPU_LIMIT=0.5

# Moodle (optional)
MOODLE_API_URL=
MOODLE_TOKEN=
